<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd（macOS）の LaunchAgent テンプレート。ログイン時に自動起動し、落ちたら再起動する。
  アプリのパスと PATH はプレースホルダで、bin/server install が実体に置換して
  ~/Library/LaunchAgents/ に設置する。手動で cp せず次のコマンドを使う:

    bin/server install     設置して launchd に登録・起動（冪等）
    bin/server status      稼働状態の確認
    bin/server restart     再起動（このテンプレートを書き換えた場合は restart では
                           反映されない。install が設置と再読込まで行う）
    bin/server uninstall   登録解除して plist を削除

  APP_ENV はここで指定しない（環境の切替は .env に任せる）。本番設定にする場合は
  .env の APP_ENV=production と、あわせて必須の APP_BASE_URL 等を設定すること。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sukesan.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>__APP_DIR__/bin/server</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__APP_DIR__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd はログインシェルの PATH を引き継がないため明示する（rbenv 等の shims を含む） -->
    <key>PATH</key>
    <string>__PATH__</string>
    <!--
      LANG も引き継がれない。未設定だと Ruby の既定外部エンコーディングが US-ASCII になり、
      日本語を含む data/*.json の読み込みが Encoding::InvalidByteSequenceError で落ちる。
    -->
    <key>LANG</key>
    <string>ja_JP.UTF-8</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__APP_DIR__/log/server.log</string>
  <key>StandardErrorPath</key>
  <string>__APP_DIR__/log/server.log</string>
</dict>
</plist>
