#!/usr/bin/env ruby
# frozen_string_literal: true

# 入力したパスワードが .env の ADMIN_PASSWORD_DIGEST と一致するかを診断する。
# 「変えていないはずのパスワードでログインできない」とき、ダイジェスト側と入力側の
# どちらが食い違っているのかを切り分けるためのもの。.env は読むだけで書き換えない。
#
# 使い方:
#   bin/check_admin_password
#   プロンプトにパスワードを入力する（エコーされないためシェル履歴にも残らない）。
#
# パスワードの平文は一切表示せず、比較用の短い指紋（SHA-256 の先頭数桁）だけを出す。

require "bundler/setup"
require "bcrypt"
require "digest"
require "dotenv"
require "io/console"

def prompt(message)
  print message
  # 端末ではエコーを抑止する（履歴・肩越しの覗き見対策）。非対話実行時は通常入力にフォールバック。
  raw = $stdin.tty? ? $stdin.noecho(&:gets) : $stdin.gets
  puts
  raw.to_s.chomp
end

env_path = File.expand_path("../.env", __dir__)
abort "見つかりません: #{env_path}" unless File.exist?(env_path)

# アプリと同じ dotenv で解釈した値を見る（シェルの環境変数には影響されない）。
digest = Dotenv.parse(env_path).fetch("ADMIN_PASSWORD_DIGEST", "")
fingerprint = digest.empty? ? "(空)" : Digest::SHA256.hexdigest(digest)[0, 12]

puts "--- .env のダイジェスト ---"
puts "指紋: #{fingerprint}  ← 控えておくと、次に再発したとき「ファイル側が変わったか」を判定できる"

unless BCrypt::Password.valid_hash?(digest)
  puts "形式: bcrypt ハッシュとして不正（この状態ではどんなパスワードも通りません）"
  puts
  puts ".env の ADMIN_PASSWORD_DIGEST をシングルクォートで囲んでいるか確認してください。"
  puts "  ADMIN_PASSWORD_DIGEST='$2a$12$...'"
  puts "囲まないと dotenv が $2a・$12 などを変数展開し、値が壊れます。"
  exit 1
end

hash = BCrypt::Password.new(digest)
puts "形式: 正常（version #{hash.version} / cost #{hash.cost}）"
puts

password = prompt("管理者パスワードを入力: ")
# LANG 未設定の環境では既定の外部エンコーディングが US-ASCII になり、端末から入った全角の
# バイト列が不正扱いになる（文字数の算出や NFKC 正規化が例外になる）。常に UTF-8 として読み直し、
# それでも不正なバイト列が残るなら置換して診断を続ける。
password = password.force_encoding(Encoding::UTF_8)
password = password.scrub unless password.valid_encoding?

non_ascii = password.each_char.count { |char| char.ord > 127 }
non_ascii_note = non_ascii.zero? ? "なし" : "#{non_ascii} 個あり（IME が日本語入力のまま打った可能性）"
space_note = password == password.strip ? "なし" : "あり（コピペで混入した可能性）"

puts "--- 入力したパスワード（値そのものは表示しません） ---"
puts "文字数: #{password.length} / バイト数: #{password.bytesize}"
puts "非 ASCII 文字: #{non_ascii_note}"
puts "前後の空白・改行: #{space_note}"
puts "指紋: #{Digest::SHA256.hexdigest(password)[0, 8]}  ← ブラウザに打つ文字列と同じものを打てているかの比較用"
puts

puts "--- 照合結果 ---"
candidates = {
  "そのまま" => password,
  "前後の空白を除去" => password.strip,
  "NFKC 正規化（全角→半角）" => password.unicode_normalize(:nfkc)
}
matched = nil
candidates.each do |label, candidate|
  ok = hash.is_password?(candidate)
  matched ||= label if ok
  puts "  #{label}: #{ok ? '一致' : '不一致'}"
end

puts
case matched
when nil
  puts "→ どの形でも一致しません。入力しているパスワード自体が .env のダイジェストと別のものです。"
  exit 1
when "そのまま"
  puts "→ 一致しました。このパスワードでログインできます。"
else
  puts "→ 「#{matched}」で一致しました。入力に余分な文字が混じっています。"
end
